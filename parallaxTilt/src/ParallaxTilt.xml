<?xml version="1.0" encoding="utf-8" ?>
<widget
    id="MxTechies.parallaxtilt.ParallaxTilt"
    pluginWidget="true"
    needsEntityContext="true"
    offlineCapable="true"
    supportedPlatform="Web"
    xmlns="http://www.mendix.com/widget/1.0/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.mendix.com/widget/1.0/ ../node_modules/mendix/custom_widget.xsd"
>
    <name>Parallax Tilt</name>
    <description>
        Shows each object of a data source as a card that tilts and shines when the mouse moves over it.
    </description>
    <icon>
        
    </icon>
    <properties>
        <propertyGroup caption="General">
            <property key="orientationKey" type="enumeration" defaultValue="horizontal">
                <caption>Orientation</caption>
                <description>
                    Horizontal places the cards in a row and wraps them to the next line when there is no room. Vertical
                    places them in a column.
                </description>
                <enumerationValues>
                    <enumerationValue key="horizontal">Horizontal</enumerationValue>
                    <enumerationValue key="vertical">Vertical</enumerationValue>
                </enumerationValues>
            </property>
            <property key="data" type="datasource" isList="true" required="true">
                <caption>Data source</caption>
                <description>One tilt card is shown for each object.</description>
            </property>
            <property key="contentTemplate" type="widgets" dataSource="data" required="true">
                <caption>Content</caption>
                <description>Content of each card.</description>
            </property>
        </propertyGroup>
        <propertyGroup caption="Configurations">
            <property key="tiltEnableKey" type="boolean" required="true" defaultValue="true">
                <caption>Tilt enabled</caption>
                <description>Turns the tilt effect on or off.</description>
            </property>
            <property key="tiltMaxAngleXKey" type="integer" required="true" defaultValue="20">
                <caption>Max tilt angle X</caption>
                <description>
                    Maximum rotation around the x-axis (mouse moving up and down), in degrees. Range: 0 to 90.
                </description>
            </property>
            <property key="tiltMaxAngleYKey" type="integer" required="true" defaultValue="20">
                <caption>Max tilt angle Y</caption>
                <description>
                    Maximum rotation around the y-axis (mouse moving left and right), in degrees. Range: 0 to 90.
                </description>
            </property>
            <property key="glareEnableKey" type="boolean" required="true" defaultValue="true">
                <caption>Glare enabled</caption>
                <description>Turns the glare (light reflection) on or off.</description>
            </property>
            <property key="glareMaxOpacityKey" type="decimal" required="true" defaultValue="0.7">
                <caption>Glare max opacity</caption>
                <description>Maximum glare opacity. Range: 0 to 1 (0.5 = 50%, 1 = 100%).</description>
            </property>
            <property key="glareColorKey" type="string" required="false" defaultValue="#ffffff">
                <caption>Glare color</caption>
                <description>Any CSS color, for example #ffffff or rgb(255, 215, 0). Empty = white.</description>
            </property>
            <property key="glarePositionKey" type="string" required="false" defaultValue="top">
                <caption>Glare position</caption>
                <description>
                    Where the glare appears: top, right, bottom, left or all. Empty or unknown = top.
                </description>
            </property>
            <property key="scaleKey" type="decimal" required="true" defaultValue="1.1">
                <caption>Scale</caption>
                <description>
                    Size of the card while the mouse is over it (1 = 100%, 1.1 = 110%). 0 or less = 1.
                </description>
            </property>
            <property key="perspectiveKey" type="integer" required="true" defaultValue="1000">
                <caption>Perspective</caption>
                <description>
                    Distance between the card and the user, in pixels. Lower values give a stronger 3D effect. 0 or less
                    = 1000.
                </description>
            </property>
            <property
                key="transitionEasingKey"
                type="string"
                required="false"
                defaultValue="cubic-bezier(.03,.98,.52,.99)"
            >
                <caption>Transition easing</caption>
                <description>
                    CSS easing function, for example ease-out or cubic-bezier(.03,.98,.52,.99). Empty =
                    cubic-bezier(.03,.98,.52,.99).
                </description>
            </property>
            <property key="transitionSpeedKey" type="integer" required="true" defaultValue="1000">
                <caption>Transition speed</caption>
                <description>Duration of the transition, in milliseconds.</description>
            </property>
            <property key="flipVerticallyKey" type="boolean" required="true" defaultValue="false">
                <caption>Flip vertically</caption>
                <description>Shows the cards upside down (rotated 180 degrees around the x-axis).</description>
            </property>
            <property key="flipHorizontallyKey" type="boolean" required="true" defaultValue="false">
                <caption>Flip horizontally</caption>
                <description>Shows the cards mirrored (rotated 180 degrees around the y-axis).</description>
            </property>
        </propertyGroup>
        <propertyGroup caption="Events">
            <property key="onMoveAction" type="action" required="false">
                <caption>On move action</caption>
                <description>
                    Runs while the mouse moves over a card. It runs very often, so use a light nanoflow.
                </description>
            </property>
            <property key="onEnterAction" type="action" required="false">
                <caption>On enter action</caption>
                <description>Runs when the mouse enters a card.</description>
            </property>
            <property key="onLeaveAction" type="action" required="false">
                <caption>On leave action</caption>
                <description>Runs when the mouse leaves a card.</description>
            </property>
        </propertyGroup>
    </properties>
</widget>
